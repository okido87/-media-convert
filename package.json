{
  "name": "mediaconvert",
  "version": "1.0.0",
  "description": "Pure in-browser MP4 to MP3 audio converter using WebAssembly & FFmpeg Core",
  "author": "Hien Nguyen - Founder EMS Solution",
  "repository": {
    "type": "git",
    "url": "https://github.com/okido87/-media-convert.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "mkdir -p public/ffmpeg/core public/ffmpeg/core-mt && cp node_modules/@ffmpeg/core/dist/esm/* public/ffmpeg/core/ && cp node_modules/@ffmpeg/core-mt/dist/esm/* public/ffmpeg/core-mt/"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
